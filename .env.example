# Comma-separated RPC endpoints. Optional per-endpoint limits: url|requestsPerSecond|perMethodPerSecond
RPC_URLS=https://api.mainnet.solana.com
RPC_RPS=8
RPC_METHOD_RPS=3.5
PORT=3001
DB_PATH=./pumpfun.db
JOB_CONCURRENCY=2
JOB_TIMEOUT_MS=480000
TRACE_RATE_LIMIT=10
FRESH_RESULT_SEC=300
# Live screener: new tokens from PumpPortal's free websocket, curves polled over RPC
FEED_ENABLED=true
PUMPPORTAL_URL=wss://pumpportal.fun/api/data
FEED_POLL_SEC=20
# Background trace when a token sells this % of its curve within the window
AUTO_TRACE_MIN_PROGRESS=40
AUTO_TRACE_WINDOW_SEC=900
AUTO_TRACE_PER_HOUR=20
FEED_RETENTION_HOURS=24
